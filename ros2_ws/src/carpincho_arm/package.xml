<?xml version="1.0"?>
<package format="3">
  <name>carpincho_arm</name>
  <version>0.1.0</version>
  <description>Driver del brazo C1 (servos Feetech STS3215), cinemática y poses.</description>
  <maintainer email="urubots@utec.edu.uy">UruBots</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>carpincho_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
