<?xml version="1.0"?>
<package format="3">
  <name>carpincho_autonomy</name>
  <version>0.1.0</version>
  <description>Comportamientos autónomos: travesía de carril ida/vuelta, flippers automáticos.</description>
  <maintainer email="urubots@utec.edu.uy">UruBots</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>carpincho_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
